# Hermes Agent - Nous Research
# API key da Nous Portal (configure depois pelo painel web ou aqui).
HERMES_API_KEY=

# --- Painel web (hermes dashboard) ---
# Acesse em http://localhost:9119  (usuario / senha abaixo)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=troque_esta_senha
# Secret estavel p/ a sessao do painel sobreviver a restart.
# Gere o seu com: openssl rand -base64 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
