# ── Backend ──────────────────────────────────────────────
APP_ENV=development

# Banco. Local (Docker): use o host 'postgres'. Para apontar ao Supabase depois,
# basta trocar esta URL pela connection string do Supabase (também Postgres).
DATABASE_URL=postgresql+psycopg://lead:lead@localhost:5432/leadhunter

# ── Google Places (New) — usado a partir da Fase 2 ───────
# NUNCA commitar a chave real. Só no backend, nunca no frontend.
GOOGLE_PLACES_API_KEY=

# ── Limites de cota ──────────────────────────────────────
API_DAILY_LIMIT=1000
API_MONTHLY_LIMIT=20000

# ── Critérios padrão de qualificação ─────────────────────
MIN_RATING=3.5
MIN_REVIEWS=20
MIN_SCORE=70

# ── Lado dos agentes (lh.mjs) ────────────────────────────
# Precisa estar no ambiente de quem roda os agentes (o serviço do OpenClaw), não só no backend.

# Onde o lh.mjs procura o backend. Instalação local pode deixar o default; agente apontando
# pra um Lead Hunter remoto põe a URL completa aqui.
LH_API=http://localhost:8000

# Time da Vercel onde as demos são publicadas. SEM ISTO o `vercel deploy` sobe pro escopo
# pessoal da conta logada, não pro time. Era o `--scope` que vinha escrito por extenso nos
# prompts — saiu de lá porque um time fixo no texto vaza para outras instalações.
VERCEL_SCOPE=

# Fotos/vídeos que a interface sobe no GERAR SITE. Vazio = ~/.openclaw/demo-uploads.
DEMO_UPLOADS_DIR=
